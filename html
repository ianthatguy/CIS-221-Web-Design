<!DOCTYPE html>
<html>

<head>
    <title>Tables</title>
</head>

<body>

    <table border="5">

        <caption>
            <b>Timetable</b>
        </caption>

        <tr>
            <th scope="col">Day/Time</th>
            <th scope="col">9am</th>
            <th scope="col">10am</th>
            <th scope="col">11am</th>
            <th scope="col">12pm</th>
        </tr>

        <tr>
            <th scope="row">Monday</th>
            <td colspan="2">CIS 210</td>
            <td>CIS 211</td>
            <td>CIS 212</td>
        </tr>

        <tr>
            <th scope="row">Tuesday</th>
            <td>CIS 122</td>
            <td>CIS 133</td>
            <td colspan="2">CIS 213</td>
        </tr>

    </table>

</body>

</html>